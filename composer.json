{
	"name": "mapsteps/erident-custom-login-and-dashboard",
	"description": "Erident Custom Login and Dashboard – customize the WordPress login screen and admin footer.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml --exclude=Generic.Files.LineEndings .",
		"fix": "phpcbf --standard=phpcs.xml --exclude=Generic.Files.LineEndings ."
	}
}
